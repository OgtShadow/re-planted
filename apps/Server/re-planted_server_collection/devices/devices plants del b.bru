meta {
  name: devices plants del b
  type: http
  seq: 11
}

delete {
  url: http://localhost:{{server}}/api/users/{{user}}/plants/{{plantB}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("delete plant B status 200 or 404", function () {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("delete plant B response is JSON or plain text", function () {
    const type = res.getHeader("content-type") || "";
    expect(type.toLowerCase()).to.satisfy(function (value) {
      return value.includes("application/json") || value.includes("text/plain");
    });
  });

  test("valid delete plant B response when status 200", function () {
    if (res.getStatus() !== 200) {
      return;
    }

    const data = res.getBody() || {};
    expect(data.response).to.include("Usunięto roślinę:");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
