meta {
  name: devices plants del a
  type: http
  seq: 10
}

delete {
  url: http://localhost:{{server}}/api/users/{{user}}/plants/{{plantA}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 404) {
    bru.runner.setNextRequest("devices plants del b");
  }
}

tests {
  test("delete plant A status 200 or 404", function () {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("delete plant A response is JSON or plain text", function () {
    const type = res.getHeader("content-type") || "";
    expect(type.toLowerCase()).to.satisfy(function (value) {
      return value.includes("application/json") || value.includes("text/plain");
    });
  });

  test("valid delete plant A response when status 200", function () {
    if (res.getStatus() !== 200) {
      return;
    }

    const data = res.getBody() || {};
    expect(data.response).to.include("Usunięto roślinę:");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
