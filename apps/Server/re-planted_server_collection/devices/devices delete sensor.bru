meta {
  name: devices delete sensor
  type: http
  seq: 16
}

delete {
  url: http://localhost:{{server}}/api/users/{{user}}/devices/{{sensorDevice}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 404) {
    bru.runner.setNextRequest("devices plants del a");
  }
}

tests {
  test("delete sensor device status 200 or 404", function () {
    expect([200, 404]).to.include(res.getStatus());
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
