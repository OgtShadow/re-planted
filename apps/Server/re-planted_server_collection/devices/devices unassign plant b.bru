meta {
  name: devices unassign plant b
  type: http
  seq: 8
}

delete {
  url: http://localhost:{{server}}/api/users/{{user}}/devices/{{device}}/plants/{{plantB}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  if (res.getStatus() === 200 || res.getStatus() === 404) {
    bru.runner.setNextRequest("devices delete");
  }
}

tests {
  test("unassign device from plant B status 200 or 404", function () {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("unassign device response is JSON or plain text", function () {
    const type = res.getHeader("content-type") || "";
    expect(type.toLowerCase()).to.satisfy(function (value) {
      return value.includes("application/json") || value.includes("text/plain");
    });
  });

  test("unassign response payload when status 200", function () {
    if (res.getStatus() !== 200) {
      return;
    }

    const data = res.getBody() || {};
    expect(data.response).to.include("Odpięto urządzenie od rośliny");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
