meta {
  name: devices assign sensor plant a
  type: http
  seq: 14
}

put {
  url: http://localhost:{{server}}/api/users/{{user}}/devices/{{sensorDevice}}/plants/{{plantA}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("devices get sensor by id");
  }
}

tests {
  test("assign sensor device to plant A status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("assign sensor device ids", function () {
    const data = res.getBody() || {};
    expect(data.deviceId).to.equal(Number(bru.getVar("sensorDevice")));
    expect(data.plantId).to.equal(Number(bru.getVar("plantA")));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
