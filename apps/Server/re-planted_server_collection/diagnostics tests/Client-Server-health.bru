meta {
  name: Client-Server-health
  type: http
  seq: 3
}

get {
  url: http://localhost:{{client_server}}/api/client-server/health
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("Client-Server-communication");
  }
}

tests {
  test("geting res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("response is JSON", function () {
    const type = res.getHeader('content-type') || "";
    expect(type.toLowerCase()).to.include("application/json");
  });
  
  test("status check", function () {
    const data = res.getBody().status || [];
    expect(data).to.equal("ok");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
