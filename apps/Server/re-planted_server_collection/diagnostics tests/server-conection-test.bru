meta {
  name: Server conection test
  type: http
  seq: 1
}

get {
  url: http://localhost:{{server}}
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("server-cummuniacation");
  }
}

tests {
  test("Server works", function () {
    const data = res.getBody() || "";
    expect(data).to.include("Server in fact działa!");
  });
}
