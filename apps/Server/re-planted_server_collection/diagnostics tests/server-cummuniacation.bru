meta {
  name: server-cummuniacation
  type: http
  seq: 1
}

get {
  url: http://localhost:{{server}}/communication-test
  body: none
  auth: inherit
}

tests {
    test("status 200", function () {
      expect(res.getStatus()).to.equal(200);
    });
  
  test("Server works", function () {
    const data = res.getBody() || "";
    expect(data).to.include("Communication with Client works!");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
