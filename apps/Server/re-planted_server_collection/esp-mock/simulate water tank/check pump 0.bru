meta {
  name: check pump 0
  type: http
  seq: 10
}

get {
  url: http://localhost:{{sensor_mock}}/sensors
  body: json
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("simulate tank");
  }
}

tests {
  test("geting res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("0 lvl chceck", function () {
    const data = res.getBody() || 1;
    expect(data.waterLevelCm).to.equal(0);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
