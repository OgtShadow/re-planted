meta {
  name: esp-mock run all
  type: http
  seq: 0
}

get {
  url: http://localhost:{{sensor_mock}}/device-state
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest('pump off');
  }
}

tests {
  test("esp-mock run all bootstrap status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
