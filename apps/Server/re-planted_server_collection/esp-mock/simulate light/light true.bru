meta {
  name: light true
  type: http
  seq: 8
}

get {
  url: http://localhost:{{sensor_mock}}/device-state
  body: json
  auth: inherit
}

body:json {
  {
    "state": true
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("0 water lvl");
  }
}

tests {
  test("geting res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("off chceck", function () {
    const data = res.getBody() || 1;
    expect(data.lightOn).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
