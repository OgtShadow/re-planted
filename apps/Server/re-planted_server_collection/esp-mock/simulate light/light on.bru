meta {
  name: light on
  type: http
  seq: 7
}

post {
  url: http://localhost:{{sensor_mock}}/command/light
  body: json
  auth: inherit
}

body:json {
  {
    "state": true,
    "durationSeconds": 5
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("light true");
  }
}

tests {
  test("geting res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
