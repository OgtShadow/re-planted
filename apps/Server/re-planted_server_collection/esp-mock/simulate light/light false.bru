tests {
  test("geting res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("off chceck", function () {
    const data = res.getBody() || 1;
    expect(data.lightOn).to.equal(false);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
