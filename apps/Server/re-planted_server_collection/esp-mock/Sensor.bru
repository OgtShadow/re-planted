meta {
  name: Sensor
  type: http
  seq: 1
}

get {
  url: http://localhost:{{sensor_mock}}/sensors
  body: none
  auth: inherit
}

tests {
  test("geting res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("response is JSON", function () {
    const type = res.getHeader('content-type') || "";
    expect(type.toLowerCase()).to.include("application/json");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
