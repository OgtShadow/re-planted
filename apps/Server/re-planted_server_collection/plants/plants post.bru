meta {
  name: plants post
  type: http
  seq: 6
}

post {
  url: http://localhost:{{server}}/api/plants
  body: json
  auth: none
}

body:json {
  {"name":"Mint","species":"Mentha"}
}

script:post-response {
  if (res.getStatus() === 200) {
      bru.runner.setNextRequest('plant get');
  }
}

tests {
  test("geting plants res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("plants response is JSON", function () {
    const type = res.getHeader('content-type') || "";
    expect(type.toLowerCase()).to.include("application/json");
  });
  
  test("valid response", function () {
    const data = res.getBody() || "";
    expect(data.response).to.equal("Dodano roślinę: Mint, Mentha");
  });
}
