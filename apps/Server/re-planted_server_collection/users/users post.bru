meta {
  name: users post
  type: http
  seq: 2
}

post {
  url: http://localhost:{{server}}/api/users
  body: json
  auth: none
}

body:json {
  {"username":"test", "email":"{{logintest}}", "password":"{{passwordtest}}"}
}

script:post-response {
  if (res.getStatus() === 200) {
      bru.setVar('after_login_next', 'users get');
      bru.runner.setNextRequest('login');
  }
}

tests {
  test("geting users res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("users response is JSON", function () {
    const type = res.getHeader('content-type') || "";
    expect(type.toLowerCase()).to.include("application/json");
  });
  
  test("valid response", function () {
    const data = res.getBody() || "";
    expect(data.response).to.include("Added user:");
  });
}
