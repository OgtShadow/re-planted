meta {
  name: users post
  type: http
  seq: 6
}

post {
  url: http://localhost:{{server}}/api/users
  body: json
  auth: none
}

body:json {
  {"Username":"Test-user"}
}

script:post-response {
  if (res.getStatus() === 200) {
      bru.runner.setNextRequest('users get');
  }
}

tests {
  test("geting users res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("userss response is JSON", function () {
    const type = res.getHeader('content-type') || "";
    expect(type.toLowerCase()).to.include("application/json");
  });
  
  test("valid response", function () {
    const data = res.getBody() || "";
    expect(data.response).to.equal("Dodano użytkownika: test-user");
  });
}
