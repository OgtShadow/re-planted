meta {
  name: users put
  type: http
  seq: 4
}

put {
  url: http://localhost:{{server}}/api/users/{{user}}
  body: json
  auth: none
}

body:json {
  {"username":"test-user-edited"}
}

script:post-response {
  if (res.getStatus() === 200) {
      bru.runner.setNextRequest('users delete');
  }
}

tests {
  test("geting users res 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("users response is JSON", function () {
    const type = res.getHeader('content-type') || "";
    expect(type.toLowerCase()).to.include("application/json");
  });
  
  test("valid response", function () {
    const data = res.getBody() || "";
    expect(data.response).to.include("Zaktualizowano użytkowwnika");
  });
}
