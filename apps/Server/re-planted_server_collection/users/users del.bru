meta {
  name: users del
  type: http
  seq: 5
}

delete {
  url: http://localhost:{{server}}/api/users/{{usertest}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("geting users res 200", function () {
      expect(res.getStatus()).to.equal(200);
    });
    
    test("users response is JSON", function () {
      const type = res.getHeader('content-type') || "";
      expect(type.toLowerCase()).to.include("application/json");
    });
    
     test("valid delete response", function () {
        const data = res.getBody() || {};
        expect(data.response).to.include("Deleted user: test-user-edited");
    });
}

settings {
  encodeUrl: true
  timeout: 0
}
