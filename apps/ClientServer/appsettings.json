{
  "MainServerApi": {
    "BaseUrl": "http://localhost:8080",
    "PlantsPath": "/api/users/{clientId}/plants",
    "AutomationRulesPath": "/api/users/{clientId}/automation-rules",
    "AutomationRuleTriggerPath": "/api/users/{clientId}/automation-rules/{ruleId}/trigger"
  },
  "MockDeviceApi": {
    "BaseUrl": "http://localhost:8085",
    "SensorsPath": "/sensors"
  },
  "IoTController": {
    "ClientIds": [ 1 ],
    "PollingIntervalSeconds": 15,
    "PumpRunSeconds": 2,
    "SoakTimeSeconds": 60,
    "LowWaterThresholdCm": 2,
    "MoistureThresholdBufferPercent": 5,
    "MaxPumpRunSeconds": 30,
    "TelemetryTimeoutSeconds": 5,
    "MaxTelemetryAgeSeconds": 30
  },
  "Mqtt": {
    "Enabled": true,
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "ClientId": "re-planted-client-server",
    "TelemetryTopicFilter": "replanted/telemetry/+/+",
    "CommandsTopicTemplate": "replanted/commands/{deviceId}",
    "DiscoveryRegisterTopic": "replanted/discovery/register",
    "NodeConfigTopicTemplate": "replanted/node/{deviceId}/config",
    "KeepAliveSeconds": 30,
    "ReconnectDelaySeconds": 5,
    "QosLevel": 1
  },
  "Mdns": {
    "Enabled": true,
    "InstanceName": "replanted-iot-controller",
    "ServiceType": "_mqtt._tcp"
  },
  "DeviceRegistration": {
    "DefaultWateringIntervalHours": 24,
    "DefaultSoilMoistureMinThreshold": 300,
    "DefaultSoilMoistureMaxThreshold": 700,
    "DefaultLightOnHour": 6,
    "DefaultLightOffHour": 20,
    "DefaultTelemetryIntervalSeconds": 60
  },
  "ControllerStateBackup": {
    "Enabled": true,
    "SaveIntervalSeconds": 60,
    "FilePath": "data/controller-state.json"
  },
  "OfflineMode": {
    "Enabled": true,
    "SnapshotValidityMinutes": 1440,
    "ContinueWithExpiredSnapshot": false
  },
  "Jwt": {
    "Key": "dev-only-super-secret-key-change-me-please-12345",
    "Issuer": "re-planted-server",
    "Audience": "re-planted-client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
