{
  "MainServerApi": {
    "BaseUrl": "http://localhost:8080",
    "PlantsPath": "/api/users/{clientId}/plants",
    "AutomationRulesPath": "/api/users/{clientId}/automation-rules",
    "AutomationRuleTriggerPath": "/api/users/{clientId}/automation-rules/{ruleId}/trigger"
  },
  "MockDeviceApi": {
    "BaseUrl": "http://localhost:8085",
    "SensorsPath": "/sensors",
    "PumpCommandPath": "/command/pump"
  },
  "IoTController": {
    "ClientIds": [ 1 ],
    "PollingIntervalSeconds": 15,
    "PumpRunSeconds": 2,
    "SoakTimeSeconds": 60,
    "LowWaterThresholdCm": 2,
    "MoistureThresholdBufferPercent": 5
  },
  "Mqtt": {
    "Enabled": true,
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "ClientId": "re-planted-client-server",
    "TelemetryTopicFilter": "replanted/telemetry/+/+",
    "CommandsTopicTemplate": "replanted/commands/{deviceId}",
    "KeepAliveSeconds": 30,
    "ReconnectDelaySeconds": 5,
    "QosLevel": 1
  },
  "ControllerStateBackup": {
    "Enabled": true,
    "SaveIntervalSeconds": 60,
    "FilePath": "data/controller-state.json"
  },
  "Jwt": {
    "Key": "dev-only-super-secret-key-change-me-please-12345",
    "Issuer": "re-planted-server",
    "Audience": "re-planted-client"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
