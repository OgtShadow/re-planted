meta {
  name: controller status
  type: http
  seq: 1
}

get {
  url: http://localhost:{{client_server}}/api/client-server/controllers/{{clientId}}/status
  body: none
  auth: none
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("status response contains controller state", function () {
    const data = res.getBody() || {};
    expect(data).to.have.property("clientId", 1);
    expect(data).to.have.property("controllerState");
    expect(data).to.have.property("isInSoak");
    expect(data).to.have.property("lastSyncUtc");
  });
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("controller topology");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
