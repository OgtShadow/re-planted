meta {
  name: controller telemetry current
  type: http
  seq: 4
}

get {
  url: http://localhost:{{client_server}}/api/client-server/controllers/{{clientId}}/telemetry/current
  body: none
  auth: none
}

tests {
  test("telemetry endpoint returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("telemetry payload includes control fields", function () {
    const data = res.getBody() || {};
    expect(data).to.have.property("clientId", 1);
    expect(data).to.have.property("deviceId");
    expect(data).to.have.property("soilMoistureAnalog");
    expect(data).to.have.property("waterLevelCm");
    expect(data).to.have.property("controllerState");
    expect(data).to.have.property("lastSyncUtc");
  });
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest("controller telemetry all clients");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
