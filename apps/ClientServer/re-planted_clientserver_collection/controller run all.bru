meta {
  name: controller run all
  type: http
  seq: 0
}

get {
  url: http://localhost:{{client_server}}/api/client-server/health
  body: none
  auth: none
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.runner.setNextRequest('controller status');
  }
}

tests {
  test("controller run all bootstrap status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
