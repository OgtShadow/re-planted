tests {
  test("telemetry all endpoint returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("telemetry all endpoint returns an array", function () {
    const data = res.getBody() || [];
    expect(data).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
