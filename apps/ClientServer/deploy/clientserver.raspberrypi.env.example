# Native systemd configuration for ClientServer on Debian/Raspberry Pi.
# Copy to /etc/re-planted-clientserver/clientserver.env and set the real JWT key.
ASPNETCORE_URLS=http://0.0.0.0:8082
ASPNETCORE_ENVIRONMENT=Production

MainServerApi__BaseUrl=http://192.168.1.67:8080
MainServerApi__PlantsPath=/api/users/{clientId}/plants
MainServerApi__AutomationRulesPath=/api/users/{clientId}/automation-rules
MainServerApi__AutomationRuleTriggerPath=/api/users/{clientId}/automation-rules/{ruleId}/trigger
ServerApi__BaseUrl=http://192.168.1.67:8080
ServerApi__CommunicationPath=/communication-test

IoTController__ClientIds__0=1
IoTController__TelemetrySource=Mqtt
IoTController__PollingIntervalSeconds=15
IoTController__PumpRunSeconds=2
IoTController__SoakTimeSeconds=60
IoTController__LowWaterThresholdCm=2
IoTController__MaxPumpRunSeconds=30
IoTController__TelemetryTimeoutSeconds=5
IoTController__MaxTelemetryAgeSeconds=30

Mqtt__Enabled=true
Mqtt__BrokerHost=127.0.0.1
Mqtt__BrokerPort=1883
Mqtt__ClientId=re-planted-client-server-pi-01
Mqtt__TelemetryTopicFilter=replanted/telemetry/+/+
Mqtt__CommandsTopicTemplate=replanted/commands/{deviceId}
Mqtt__DiscoveryRegisterTopic=replanted/discovery/register
Mqtt__NodeConfigTopicTemplate=replanted/node/{deviceId}/config
Mqtt__KeepAliveSeconds=30
Mqtt__ReconnectDelaySeconds=5
Mqtt__QosLevel=1

Mdns__Enabled=true
Mdns__InstanceName=replanted-iot-controller-pi-01
Mdns__ServiceType=_mqtt._tcp

ControllerStateBackup__Enabled=true
ControllerStateBackup__SaveIntervalSeconds=60
ControllerStateBackup__FilePath=/opt/re-planted-clientserver/data/controller-state.json
OfflineMode__Enabled=true
OfflineMode__SnapshotValidityMinutes=1440
OfflineMode__ContinueWithExpiredSnapshot=false

Jwt__Key=dev-only-super-secret-key-change-me-please-12345
Jwt__Issuer=re-planted-server
Jwt__Audience=re-planted-client
Serilog__MinimumLevel__Default=Information
